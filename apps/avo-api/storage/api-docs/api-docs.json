                    }
                ]
            }
        },
        "/api/admin/users/{id}/toggle-status": {
            "patch": {
                "tags": [
                    "Admin Users"
                ],
                "summary": "Toggle user status",
                "operationId": "bbe326c9135c1f182141e800aa11f1d9",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
